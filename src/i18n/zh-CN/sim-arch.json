    {"ctx":"src/sims/arch.js:126","ko":"필드 {0} 서버의 틱이 늦어져 그 필드만 느리게 흐르거나 뚝뚝 끊기고, 이동 판정이 어긋나 뒤로 당겨집니다. 다른 필드는 멀쩡합니다.","t":""},
    {"ctx":"src/sims/arch.js:127","ko":"필드 {0} 서버가 멈춰 화면이 굳었다가 접속이 끊깁니다. 필드 {1}로 이동하려는 사람도 들어가지 못합니다.","t":""},
    {"ctx":"src/sims/arch.js:131, src/sims/arch.js:132","ko":"그 플레이어 한 명","t":""},
    {"ctx":"src/sims/arch.js:131, src/sims/arch.js:132","ko":"한 명","t":""},
    {"ctx":"src/sims/arch.js:131","ko":"집 와이파이나 회선이 불안정하면 그 사람만 렉을 겪습니다. 서버와 다른 플레이어는 멀쩡합니다.","t":""},
    {"ctx":"src/sims/arch.js:132","ko":"내 인터넷이 끊기면 나만 접속이 끊깁니다. 서버는 캐릭터를 잠시 남겨 두었다가 정리합니다.","t":""},
    {"ctx":"src/sims/arch.js:135, src/sims/arch.js:136, src/sims/arch.js:139, src/sims/arch.js:178, src/sims/arch.js:179, src/sims/arch.js:181, src/sims/arch.js:182, src/sims/arch.js:242","ko":"전원","t":""},
    {"ctx":"src/sims/arch.js:135","ko":"공격 트래픽을 걸러 내느라 검사 장비가 바빠 모든 패킷이 조금씩 늦고 일부는 버려집니다.","t":""},
    {"ctx":"src/sims/arch.js:136","ko":"전원 (오탐이면 일부 지역·통신사만)","t":""},
    {"ctx":"src/sims/arch.js:136","ko":"모든 접속이 이 장비를 지나므로 장비가 멈추면 전원의 접속이 끊기고 다시 들어오지 못합니다. 장비가 정상 사용자를 공격으로 잘못 알고(오탐) 특정 통신사 주소 대역만 막으면 그 사람들만 이렇게 됩니다.","t":""},
    {"ctx":"src/sims/arch.js:139","ko":"전원 (특히 새로 접속하는 사람)","t":""},
    {"ctx":"src/sims/arch.js:139","ko":"모든 연결이 로드밸런서(접속을 여러 서버에 나눠 주는 장비)를 지나므로 접속과 로딩이 늦고, 게임 중 패킷도 조금 늦습니다.","t":""},
    {"ctx":"src/sims/arch.js:140","ko":"새로 접속하는 사람 전원 (중계 방식이면 게임 중인 사람도)","t":""},
    {"ctx":"src/sims/arch.js:140","ko":"새 접속 전원","t":""},
    {"ctx":"src/sims/arch.js:140","ko":"새 연결을 나눠 줄 곳이 없습니다. 연결을 중계하는 방식이면 이미 붙은 연결도 함께 끊기고, 처음 연결만 이어 주는 방식이면 게임 중인 사람은 버팁니다.","t":""},
    {"ctx":"src/sims/arch.js:143","ko":"로그인·결제하는 사람","t":""},
    {"ctx":"src/sims/arch.js:143","ko":"로그인·결제","t":""},
    {"ctx":"src/sims/arch.js:143","ko":"외부 플랫폼 응답이 늦어 로그인과 결제가 오래 걸립니다.","t":""},
    {"ctx":"src/sims/arch.js:144","ko":"결제하는 사람 · 새로 로그인하는 사람","t":""},
    {"ctx":"src/sims/arch.js:144","ko":"결제·새 로그인","t":""},
    {"ctx":"src/sims/arch.js:144","ko":"서킷 브레이커가 외부 호출을 바로 끊어 “잠시 후 다시 시도” 안내가 빨리 뜹니다. 게임 중인 사람은 결제만 안 됩니다.","t":""},
    {"ctx":"src/sims/arch.js:144","ko":"결제가 실패하고 플랫폼 로그인이 막힙니다. 게임 중인 사람은 결제만 안 됩니다.","t":""},
    {"ctx":"src/sims/arch.js:147, src/sims/arch.js:148","ko":"새로 로그인하는 사람","t":""},
    {"ctx":"src/sims/arch.js:147, src/sims/arch.js:148","ko":"새 로그인","t":""},
    {"ctx":"src/sims/arch.js:147","ko":"로그인 버튼 뒤 대기가 길어집니다. 로그인 서버가 느린 것만으로는 이미 게임 중인 사람에게 영향이 없습니다.","t":""},
    {"ctx":"src/sims/arch.js:148","ko":"로그인 서버가 멈춘 것만으로는 이미 접속한 사람의 접속이 끊기지 않습니다. 하지만 한 번 끊기면 다시 들어올 수 없습니다.","t":""},
    {"ctx":"src/sims/arch.js:151, src/sims/arch.js:152","ko":"그 게이트웨이에 붙은 약 1/3","t":""},
    {"ctx":"src/sims/arch.js:151, src/sims/arch.js:152","ko":"약 1/3","t":""},
    {"ctx":"src/sims/arch.js:151","ko":"모든 패킷이 게이트웨이를 거쳐 가므로 입력이 늦게 닿고, 밀린 결과가 한꺼번에 도착합니다.","t":""},
    {"ctx":"src/sims/arch.js:152","ko":"세션(접속 상태)을 들고 있던 서버가 사라져 붙어 있던 사람 모두의 접속이 끊깁니다. 나머지 두 대에 붙은 사람은 멀쩡합니다.","t":""},
    {"ctx":"src/sims/arch.js:157","ko":"던전 안에 있는 파티","t":""},
    {"ctx":"src/sims/arch.js:157","ko":"던전 서버가 느려 보스 패턴과 스킬 판정이 늦습니다. 분명 피했는데 맞는 일이 생깁니다.","t":""},
    {"ctx":"src/sims/arch.js:158","ko":"던전 안 사람 · 던전에 들어가려는 사람","t":""},
    {"ctx":"src/sims/arch.js:158","ko":"던전 진행이 끊기고 보상이 사라질 수 있습니다. 새 던전 입장도 안 됩니다.","t":""},
    {"ctx":"src/sims/arch.js:161","ko":"채팅하는 사람","t":""},
    {"ctx":"src/sims/arch.js:161, src/sims/arch.js:162","ko":"채팅","t":""},
    {"ctx":"src/sims/arch.js:161","ko":"채팅이 몇 초 늦게 도착합니다. 전투와 이동은 멀쩡합니다.","t":""},
    {"ctx":"src/sims/arch.js:162","ko":"전원 (채팅만)","t":""},
    {"ctx":"src/sims/arch.js:162","ko":"채팅과 귓속말만 안 됩니다. 게임 플레이는 멀쩡합니다.","t":""},
    {"ctx":"src/sims/arch.js:165","ko":"파티·길드 기능 쓰는 사람","t":""},
    {"ctx":"src/sims/arch.js:165","ko":"파티·길드","t":""},
    {"ctx":"src/sims/arch.js:165","ko":"파티 초대와 길드 창이 늦게 열립니다.","t":""},
    {"ctx":"src/sims/arch.js:166","ko":"파티·길드 기능 쓰는 사람 · 던전에 들어가려는 사람","t":""},
    {"ctx":"src/sims/arch.js:166","ko":"파티·던전 입장","t":""},
    {"ctx":"src/sims/arch.js:166","ko":"파티를 만들 수 없어 파티가 필요한 던전 입장도 막힙니다.","t":""},
    {"ctx":"src/sims/arch.js:169, src/sims/arch.js:170","ko":"경매장 이용자","t":""},
    {"ctx":"src/sims/arch.js:169, src/sims/arch.js:170","ko":"경매장","t":""},
    {"ctx":"src/sims/arch.js:169","ko":"검색과 구매 버튼 반응이 늦습니다. 경매장 서버 탓으로 사냥과 전투가 느려지지는 않습니다.","t":""},
    {"ctx":"src/sims/arch.js:170","ko":"경매장만 열리지 않습니다. 경매장 서버 탓으로 사냥과 전투가 멈추지는 않습니다.","t":""},
    {"ctx":"src/sims/arch.js:173","ko":"게임 서버가 캐시 응답을 오래 기다리지 않아 인벤토리·랭킹 창이 조금 늦게 열리는 정도입니다.","t":""},
    {"ctx":"src/sims/arch.js:178","ko":"전원 (누군가 저장할 때마다)","t":""},
    {"ctx":"src/sims/arch.js:178","ko":"게임 서버가 DB를 1초까지만 기다리고 포기합니다. 서킷 브레이커가 열리기 전까지는 누군가 저장할 때마다 틱이 최대 1초씩 멈추고, 그 뒤로는 바로 “저장 실패”로 처리해 게임은 계속됩니다. 1초 안에 겨우 답하는 느린 DB라면 실패로 세지 않아 서킷 브레이커가 열리지 않고 짧은 멈춤이 계속됩니다.","t":""},
    {"ctx":"src/sims/arch.js:179","ko":"전원 (저장할 때)","t":""},
    {"ctx":"src/sims/arch.js:179","ko":"게임은 멀쩡히 돌지만 얻은 아이템·우편이 늦게 들어옵니다(저장 지연).","t":""},
    {"ctx":"src/sims/arch.js:179","ko":" 너무 오래 걸리는 저장은 실패로 끊어 대기열이 쌓이지 않게 합니다.","t":""},
    {"ctx":"src/sims/arch.js:181","ko":"서킷 브레이커가 DB 호출을 바로 끊어 게임은 계속됩니다. 대신 저장이 모두 실패해 거래·강화·우편이 막히고, 그동안의 진행은 되돌려질 수 있습니다.","t":""},
    {"ctx":"src/sims/arch.js:182","ko":"게임은 돌지만 저장할 것이 메모리에 계속 쌓입니다. 이대로 서버가 재시작되면 그동안의 진행이 사라집니다(롤백).","t":""},
